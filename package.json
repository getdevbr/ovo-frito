{
  "name": "carro-do-ovo",
  "productName": "Carro do Ovo — 100% Local-First API Client",
  "version": "1.0.0",
  "description": "Carro do Ovo — Cliente HTTP portátil 100% Local-First com exportação nativa .ovo",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "node server-fallback.js",
	"dist":"electron-builder"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "cviniciusdr",
    "productName": "Carro do Ovo",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "renderer/android-chrome-512x512.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "target": "dmg"
    }
  }
}
